{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topovium.org/schemas/benchmark-result.schema.json",
  "title": "Topovium benchmark result",
  "description": "One benchmark run, published verbatim to topovium.org/benchmarks. Everything needed to judge or reproduce the number is required; nothing is left to a caption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sceneId", "commit", "timestamp", "capability", "resolution",
    "qualityLeversEngaged", "cpuFrame", "memoryPeak", "stallCount", "reproCommand"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "sceneId": { "type": "string" },
    "commit": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "capability": { "$ref": "https://topovium.org/schemas/capability-report.schema.json" },
    "resolution": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "qualityLeversEngaged": {
      "type": "integer",
      "minimum": 0,
      "description": "How many quality reductions were active. A faster run at a higher number is not a faster run, and the comparison tool refuses to compare across values."
    },
    "cpuFrame": { "$ref": "#/$defs/timingSummary" },
    "gpuFrame": { "oneOf": [{ "$ref": "#/$defs/timingSummary" }, { "type": "null" }] },
    "inputToPixel": { "oneOf": [{ "$ref": "#/$defs/timingSummary" }, { "type": "null" }] },
    "memoryPeak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuBytes"],
      "properties": {
        "cpuBytes": { "type": "integer", "minimum": 0 },
        "gpuBytes": { "type": ["integer", "null"] },
        "sharedBytes": { "type": ["integer", "null"] }
      }
    },
    "stallCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Frames exceeding the 50 ms stall threshold. A new stall blocks the merge regardless of percentiles."
    },
    "reproCommand": {
      "type": "string",
      "minLength": 1,
      "description": "The exact command that produced this result. A number nobody can reproduce is not evidence."
    }
  },
  "$defs": {
    "timingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50Ms", "p95Ms", "p99Ms", "maxMs", "sampleCount"],
      "description": "Percentiles, never an average. An average hides exactly the stalls users feel.",
      "properties": {
        "p50Ms": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "p99Ms": { "type": "number", "minimum": 0 },
        "maxMs": { "type": "number", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
